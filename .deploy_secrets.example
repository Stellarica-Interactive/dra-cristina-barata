# FTP credentials for the deploy scripts. NOT committed -- see .gitignore.
#
# Setup:
#   cp .deploy_secrets.example .deploy_secrets
#   # fill in the values below, then run either variant:
#   macOS/Linux (lftp):   ./deploy.sh
#   Windows (WinSCP):     .\deploy.ps1
#
# Both variants read THIS file, so credentials live in one place only.
#
# Host may be a hostname or "host:port" (e.g. ftp.example.com:21).
# If a password contains $ ` " or \, keep the single quotes and escape nothing;
# single-quoted strings in bash are literal. For a literal ' write '\''
#
# FTP_PROTOCOL is optional and used by deploy.ps1 only:
#   ftpes (default) = FTP with explicit TLS
#   ftps            = FTP with implicit TLS
#   ftp             = plain FTP, no encryption -- only if the server has no TLS

# --- dracristinabarata.pt: public/ -> remote login home directory ---
FTP_HOST='ftp.example.com'
FTP_USER='username'
FTP_PASS='password'
#FTP_PROTOCOL='ftpes'
